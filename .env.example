# Environment Configuration for QASP v1.0-beta
# Copy this file to .env and fill in your values

# Server Configuration
QASP_HOST=0.0.0.0
QASP_PORT=8000
QASP_WORKERS=4

# Database Configuration
DATABASE_URL=postgresql://qasp:password@localhost/qasp
# For development: DATABASE_URL=sqlite:///./qasp.db

# Cryptographic Algorithms (crypto-agility)
KEM_ALG=Kyber512
SIG_ALG=Dilithium3

# HSM/KMS Configuration
HSM_ENABLED=true
HSM_TYPE=mock
MASTER_KEY=your-32-byte-hex-master-key-here

# AWS KMS Configuration (if HSM_TYPE=aws_kms)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id

# HashiCorp Vault Configuration (if HSM_TYPE=vault)
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=your-vault-token-here

# Telemetry Configuration
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# Security Configuration
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_PERIOD=60
ENABLE_REQUEST_SIGNATURES=true

# Multi-tenant Configuration
DEFAULT_TENANT_ID=default

# Key Rotation Configuration
KEY_ROTATION_ENABLED=true
KEY_ROTATION_INTERVAL_HOURS=24

# QASP v2.0 Autonomous Orchestration Configuration
# AI-driven policy agent settings
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0.3
MAX_RISK_TOLERANCE=0.7
MIN_CONFIDENCE_THRESHOLD=0.8

# Autonomous rotation daemon settings
POLICY_CHECK_INTERVAL=60
ROTATION_COOLDOWN=3600
TELEMETRY_WINDOW=300
AI_POLICY_AGENT_ENABLED=true
POLICY_REFRESH_INTERVAL=60
